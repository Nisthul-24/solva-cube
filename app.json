{
  "expo": {
    "name": "SolvaCube",
    "slug": "solvacube",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "solvacube",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#181614"
    },
    "android": {
      "package": "com.solvacube.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181614"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SolvaCube uses the camera to scan and recognize your cube's face colors automatically.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-XXXX~YYYY",
          "iosAppId": "ca-app-pub-XXXX~YYYY",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "adMob": {
        "androidAppId": "ca-app-pub-XXXX~YYYY",
        "bannerAdUnitId": "ca-app-pub-XXXX/BBBB",
        "interstitialAdUnitId": "ca-app-pub-XXXX/IIII",
        "rewardedAdUnitId": "ca-app-pub-XXXX/RRRR"
      }
    }
  }
}

