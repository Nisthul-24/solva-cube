{
  "expo": {
    "name": "SolvaCube",
    "slug": "solvacube",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "solvacube",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#181614"
    },
    "android": {
      "package": "com.solvacube.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#181614"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SolvaCube uses the camera to scan and recognize your cube's face colors automatically.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2748169504355594~2047960594",
          "iosAppId": "ca-app-pub-2748169504355594~2047960594",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://nisthul-24.github.io/solvacube-privacy/privacy-policy.html",
      "adMob": {
        "androidAppId": "ca-app-pub-2748169504355594~2047960594",
        "bannerAdUnitId": "ca-app-pub-2748169504355594/3203140495",
        "interstitialAdUnitId": "ca-app-pub-2748169504355594/4947467009",
        "rewardedAdUnitId": "ca-app-pub-2748169504355594/3770116708"
      },
      "router": {},
      "eas": {
        "projectId": "c603e231-db2b-49e1-9aea-7275fd8d4ebb"
      }
    },
    "owner": "nisthul"
  }
}
